{
  "name": "pureiina",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "serve-sidebar": "parcel serve ui/sidebar/index.html --dist-dir dist/ui/sidebar",
    "serve-overlay": "parcel serve ui/overlay/index.html --dist-dir dist/ui/overlay",
    "build": "rm -rf dist .parcel-cache && parcel build --target overlay --no-content-hash && parcel build --target sidebar --no-content-hash && parcel build --target entry --no-content-hash",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "iina-plugin-definition": "^0.99.5",
    "prettier": "^3.5.0",
    "process": "^0.11.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "parcel": "^2.16.0",
    "parcel-optimizer-webview": "git+https://github.com/iina/parcel-optimizer-webview.git",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "browserslist": "safari >= 9",
  "entry": "src/index.js",
  "targets": {
    "main": false,
    "overlay": {
      "distDir": "./dist/ui/overlay",
      "source": "ui/overlay/index.html",
      "publicUrl": "./",
      "outputFormat": "global"
    },
    "sidebar": {
      "distDir": "./dist/ui/sidebar",
      "source": "ui/sidebar/index.html",
      "publicUrl": "./",
      "outputFormat": "global"
    },
    "entry": {
      "distDir": "./dist/",
      "source": "src/index.ts",
      "isLibrary": false
    }
  }
}
